# Postgres connection string. On Railway, reference the Postgres plugin:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/ogilvy_fun_club"

# Shared PIN that gates /admin. There is no user account system — anyone with
# this PIN can manage the event, so pick something long and rotate it after the
# event. Rotating it also signs out every existing admin session.
ADMIN_PIN="change-me"

# --- Logo storage (optional) -------------------------------------------------
# Preferred: an unsigned Cloudinary upload preset. When both are set, uploaded
# logos go to Cloudinary and only the URL is stored in Postgres, so they survive
# redeploys.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"

# Fallback: write logos to disk. Railway's container filesystem is wiped on
# every redeploy, so point this at a mounted Railway volume if you rely on it.
# Defaults to ./.uploads
# UPLOAD_DIR="/data/uploads"

# Only needed if you run the Postgres integration tests against a separate
# throwaway database. Falls back to DATABASE_URL; the tests skip if neither is
# set. These tests DELETE all event rows — never point them at production.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/ofc_test"
